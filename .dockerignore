# Version control
.git
.gitignore
.github

# Node deps never needed in the build context
**/node_modules
# NOTE: on deploy/render-public we PRE-BUILD frontend/dist locally and COPY it
# in Dockerfile.render (the free-tier builder can't run npm ci), so dist must
# stay in the build context here. The canonical Dockerfile builds it in-image.

# Python caches & virtualenvs
**/__pycache__
*.pyc
*.pyo
.venv
venv
.pytest_cache
.mypy_cache
.ruff_cache

# Local env / secrets
.env
*.env
edge/.env

# Not needed at runtime
app-appkit
docs
*.md

# Editor / OS cruft
.vscode
.idea
.DS_Store

# Screenshots / recordings / scratch artifacts
*.png
*.jpg
*.jpeg
*.gif
*.mp4
*.mov
screenshots
recordings
