%%{init: {'theme': 'base', 'themeVariables': {'primaryColor': '#e0e7ff', 'primaryBorderColor': '#4f46e5', 'primaryTextColor': '#1e1b4b', 'lineColor': '#64748b', 'secondaryColor': '#f0fdf4', 'tertiaryColor': '#fffbeb'}}}%%

flowchart LR
    subgraph Users["👤 Client Users"]
        U[OEM / Client Users<br/>no Databricks login]
    end

    subgraph App["🔵 APEX App (Databricks App OR external Docker host)"]
        direction TB
        subgraph UI["React Frontend"]
            direction LR
            DASH["📊 Dashboard Embed<br/>SDK + f_ filter params<br/>logo hidden"]
            GENIE_UI["✨ Ask APEX<br/>Genie One MCP"]
            EXEC["📄 Executive Summary<br/>per-space Genie MCP"]
        end
        subgraph BE["FastAPI Backend"]
            direction LR
            API_EMBED["/api/embed/token<br/>scoped embed token"]
            API_MCP["/api/genie-mcp/*<br/>MCP streaming SSE"]
            API_APEX["/api/apex/*<br/>history + filter prefs"]
            API_AUTH["/login · /logout<br/>white-label IdP"]
        end
    end

    subgraph Platform["🟡 Databricks Workspace"]
        direction TB
        subgraph AIBI["AI/BI Layer"]
            direction LR
            LV["📊 AI/BI Dashboard"]
            MCP["🔮 Managed Genie MCP<br/>(Genie One + per-space)"]
            GS["🧠 Genie Space"]
        end
        subgraph DATA["Unity Catalog"]
            direction LR
            MV["📐 Metric View<br/>governed dimensions + measures"]
            SRC["📦 Source Table"]
        end
        WH["⚡ SQL Warehouse"]
        LB[("🐘 Lakebase<br/>Postgres")]
    end

    SP{{"🔑 Service Principal<br/>(M2M auth)"}}

    %% User flows
    U -->|"Browser"| DASH
    U -->|"Browser"| GENIE_UI
    U -->|"Browser"| EXEC

    %% Auth
    API_AUTH -.->|"signed session cookie"| U
    BE -->|"authenticates as"| SP
    SP --> Platform

    %% Dashboard embed
    DASH --> API_EMBED
    API_EMBED -->|"CAN_RUN token"| LV

    %% Ask APEX + Executive Summary via MCP
    GENIE_UI --> API_MCP
    EXEC --> API_MCP
    API_MCP -->|"MCP tool calls"| MCP
    MCP --> GS

    %% Persistence
    API_APEX --> LB

    %% Data layer
    LV -->|"Dataset queries"| MV
    GS -->|"MEASURE() queries"| MV
    MV --> SRC
    MV --> WH

    %% Styling
    classDef appNode fill:#e0e7ff,stroke:#4f46e5,color:#1e1b4b
    classDef platformNode fill:#fffbeb,stroke:#d97706,color:#78350f
    classDef dataNode fill:#f0fdf4,stroke:#16a34a,color:#14532d
    classDef authNode fill:#fef2f2,stroke:#dc2626,color:#7f1d1d

    class DASH,GENIE_UI,EXEC,API_EMBED,API_MCP,API_APEX,API_AUTH appNode
    class LV,MCP,GS,WH platformNode
    class MV,SRC,LB dataNode
    class SP authNode
