# =====================================================================
# APEX — environment contract for hosting OUTSIDE Databricks Apps
# (EC2, ECS/Fargate, generic Docker, etc.)
#
# Copy to `.env` and fill in the blanks:  cp .env.example .env
# The app reaches Databricks purely via a Service Principal (M2M) using
# the standard SDK env vars below — no Databricks Apps platform required.
# =====================================================================

# ── Databricks Service Principal (M2M) ──────────────────────────────
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
# ── Data assets ─────────────────────────────────────────────────────
GENIE_SPACE_ID=01f127092d2219f3be10180d79b2ee5d
DASHBOARD_URL=https://<your-workspace>.cloud.databricks.com/embed/dashboardsv3/<dashboard-id>?o=<org-id>
# ── App ─────────────────────────────────────────────────────────────
APP_PORT=8000
# ── White-label login (OEM IdP) ─────────────────────────────────────
AUTH_ENABLED=true
AUTH_SESSION_SECRET=change-me-to-a-long-random-string
AUTH_SESSION_COOKIE=apex_session
AUTH_SESSION_TTL_SECONDS=28800
AUTH_USERS_FILE=server/auth/users.seed.json
AUTH_USERS_TABLE=apex_app_users
# ── Lakebase (Databricks managed Postgres) ──────────────────────────
# Powers THREE things in this app, all in one managed Postgres:
#   1. the white-label user directory (falls back to AUTH_USERS_FILE when off)
#   2. conversation history for the Ask Genie experience
#   3. per-user dashboard filter preferences
# When false, the app runs entirely in-memory + JSON (zero Lakebase setup).
LAKEBASE_ENABLED=false
# Lakebase Autoscaling project id (display/reference).
LAKEBASE_INSTANCE_NAME=apex
# Endpoint resource path used to MINT the short-lived Postgres credential, e.g.
#   projects/<project-id>/branches/production/endpoints/primary
# Get it from: databricks postgres get-endpoint <path> -p <profile>
LAKEBASE_ENDPOINT_PATH=
# Local dev only: a Databricks CLI profile whose user mints the credential.
# Leave BLANK in production so the app's Service Principal mints it (the SP must
# have a Postgres role on the instance).
LAKEBASE_PROFILE=
# Postgres endpoint host (from the get-endpoint output above).
PGHOST=
PGPORT=5432
PGDATABASE=databricks_postgres
# Postgres login identity: the user email (local dev) or SP client id (prod).
PGUSER=
PGSSLMODE=require
# ── Multi-tenant per-SP isolation (server/tenants/) ─────────────────
# Each logged-in user (by their tenant_id) maps to a dedicated tenant
# Service Principal; Genie MCP + AI/BI embed run AS that SP, and a Unity Catalog
# row filter keyed on session_user() enforces isolation. When unset the app runs
# on the single-app-SP path (no per-tenant isolation).
#
# AES-256 key (urlsafe base64 of 32 bytes) that encrypts tenant SP secrets at
# rest in Lakebase. Generate one:  python -m server.tenants.crypto
AES_KEY_BASE64=
# Unity Catalog catalog/schema holding the governed fact table, the
# tenant_row_filter function, and the sp_tenant_mapping lookup.
UC_CATALOG=
UC_SCHEMA=
# SQL warehouse (by name) used for admin SQL (mapping writes, verification).
WAREHOUSE_NAME=Serverless Starter Warehouse
# Governed fact table + tenant column the row filter is attached to / verified on.
VERIFY_TABLE=
TENANT_COLUMN=tenant_id
# Optional label column on VERIFY_TABLE for the onboard client picker (e.g. client_name).
TENANT_LABEL_COLUMN=
# Comma-separated tables to attach the row filter to (defaults to VERIFY_TABLE).
ISOLATED_TABLES=
# Account group whose members bypass the row filter (admins / back-office).
TENANT_ADMIN_GROUP=admins
# Comma-separated Lakeview dashboard ids each tenant SP is granted CAN_RUN on at
# onboard. REQUIRED for scoped embed-token minting to succeed as the tenant SP.
DASHBOARD_IDS=
# Grantable resource catalog for the admin "Manage access" UI. Comma-separated
# `id:Label` pairs; falls back to DASHBOARD_IDS / GENIE_SPACE_ID when unset.
RESOURCE_DASHBOARDS=
RESOURCE_GENIE_SPACES=
#
# ── Reuse an EXISTING customer filter (optional) ─────────────────────
# By default onboarding writes to this app's own sp_tenant_mapping(sp_app_id,
# tenant_id, active) and attaches tenant_row_filter. To instead REUSE a filter
# that already exists in the customer's UC, point these at that table/columns and
# set FILTER_FUNCTION to the existing function. Onboarding then writes the SP
# app id into the customer's mapping table so their filter enforces isolation.
# Example (Advito): client_access_filter on current_user() joined to
# user_client_access(user_email, client_id); the fact table's tenant col is client_id.
#   MAPPING_TABLE=user_client_access
#   MAPPING_USER_COLUMN=user_email        # holds the SP app id
#   MAPPING_TENANT_COLUMN=client_id
#   MAPPING_ACTIVE_COLUMN=                # empty: table has no active flag -> deactivate deletes the row
#   MAPPING_TS_COLUMN=granted_at          # optional timestamp stamped on insert
#   FILTER_FUNCTION=client_access_filter
#   TENANT_COLUMN=client_id               # (fact-table tenant column, above)
#   TENANT_LABEL_COLUMN=client_name       # shown in the onboard client picker
MAPPING_TABLE=sp_tenant_mapping
MAPPING_USER_COLUMN=sp_app_id
MAPPING_TENANT_COLUMN=tenant_id
MAPPING_ACTIVE_COLUMN=active
MAPPING_TS_COLUMN=
FILTER_FUNCTION=tenant_row_filter
# Display-name prefix for onboarded tenant Service Principals.
TENANT_SP_PREFIX=apex-tenant
# Optional: CLI profile used ONLY for SP lifecycle (create/rotate/delete), which
# needs workspace-admin. Lets you onboard locally as an admin without making the
# app SP an admin. Leave blank to use the app SP.
TENANTS_ADMIN_PROFILE=
