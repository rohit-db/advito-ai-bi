# Frontend (Vite) build-time configuration.
# Copy to `frontend/.env` and set for your workspace, then rebuild the frontend.
# These are the only workspace identifiers baked into the client bundle; when
# unset, config.ts falls back to the built-in demo defaults.

# Databricks workspace host used to build dashboard embed URLs.
VITE_WORKSPACE_URL=https://<your-workspace>.cloud.databricks.com

# Workspace org id (the `o=` query param on embed URLs).
VITE_WORKSPACE_ORG=<your-org-id>

# Note: the dashboard ids themselves live in the DASHBOARDS registry in
# frontend/src/config.ts (declarative, per-dashboard). Only the shared
# workspace host + org are environment-driven here.
